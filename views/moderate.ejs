<!DOCTYPE html>
<html lang="en">
<head>
    <title>Moderation Panel</title>
</head>
<body>
    <h1>Command Moderation Panel</h1>
    <a href="/">Back to Extranet Feed</a>
    <hr>

    <h3>Active User Accounts</h3>
    <ul>
        <% users.forEach(user => { %>
            <li>
                <strong><%= user.username %></strong> (<%= user.role %>)
                <form action="/delete-user/<%= user.id %>" method="POST" style="display:inline;">
                    <button type="submit" style="color: red;">Ban/Delete User</button>
                </form>
            </li>
        <% }) %>
    </ul>
</body>
</html>
